!/funvip/external/mmseqs_Windows/bin/*.exe
!/funvip/external/mmseqs_Windows/bin/*.dll
/funid/__pycache__/*.pyc
/funip/__pycache__/*.pyc
/funvip/__pycache__/*.pyc
/DB/*.xlsx
